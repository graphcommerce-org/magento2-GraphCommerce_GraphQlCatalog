    "type": "magento2-module",
    "license": "MIT",
    "require": {
        "php": "~8.1.0|~8.2.0|~8.3.0|~8.4.0",
        "magento/framework": "*",
        "magento/module-catalog": "*",
        "magento/module-catalog-graph-ql": "*",
        "magento/module-eav": "*",
        "magento/module-eav-graph-ql": "*",
        "magento/module-swatches": "*",
        "magento/module-swatches-graph-ql": "*",
